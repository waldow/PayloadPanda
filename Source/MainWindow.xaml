<Window x:Class="PayloadPanda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PayloadPanda.ViewModels"
        xmlns:models="clr-namespace:PayloadPanda.Models"
        xmlns:views="clr-namespace:PayloadPanda.Views"
        xmlns:helpers="clr-namespace:PayloadPanda.Helpers"
        mc:Ignorable="d"
        Title="PayloadPanda"
        Height="750" Width="1200"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="None"
        Icon="images/app.ico"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewRequestCommand}"/>
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseSelectedTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="Tab" Command="{Binding NextTabCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Tab" Command="{Binding PreviousTabCommand}"/>
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            BorderBrush="{DynamicResource WindowBorderAccent}"
            BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Image Source="images/app.ico" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PayloadPanda" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="v0.5" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="8,0,0,2" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <!-- The active environment: its variables apply to every request. -->
                        <Border CornerRadius="4" VerticalAlignment="Center" Margin="0,0,4,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource BgInput}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="The environment whose variables apply to every request">
                            <ComboBox ItemsSource="{Binding Environments.Choices}"
                                      SelectedItem="{Binding Environments.SelectedChoice}"
                                      FontSize="12" MinWidth="150" MaxWidth="220" BorderThickness="0"/>
                        </Border>
                        <Button Content="Environments" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding Environments.ManageCommand}"
                                ToolTip="Edit environments and globals"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,2"/>
                        <Button Content="Export" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ExportRequestCommand}" Margin="0,0,4,0"/>
                        <Button Content="Import" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ImportRequestCommand}" Margin="0,0,4,0"/>
                        <Button Content="Copy Curl" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding CopyAsCurlCommand}" Margin="0,0,4,0"/>
                        <Button Content="&#x2699;" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding OpenSettingsCommand}" ToolTip="Settings"
                                FontSize="15" Padding="6,4" Margin="0,0,4,0"/>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,2"/>
                        <Button Content="AI Import" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding OpenAiImportCommand}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowChromeButton}"
                                Click="MinimizeButton_Click" ToolTip="Minimize">
                            <Path Data="M 0 0 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="1"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowChromeButton}"
                                Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                            <Path x:Name="MaximizeRestoreIcon" Data="M 0 0 H 10 V 10 H 0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowChromeCloseButton}"
                                Click="CloseButton_Click" ToolTip="Close">
                            <Path Data="M 0 0 L 10 10 M 0 10 L 10 0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="270"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Border.Resources>
                        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                    </Border.Resources>
                    <TabControl SelectedIndex="{Binding LeftPanelTabIndex}"
                                Style="{StaticResource SidebarTabs}">
                        <TabItem Padding="10,9">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Saved" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SavedRequests.Count}" FontSize="11" FontWeight="Normal"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="8,6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Button Content="+ New request" Style="{StaticResource OutlineButton}"
                                            Command="{Binding NewRequestCommand}"
                                            HorizontalAlignment="Stretch"/>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding SavedRequests}"
                                         SelectedItem="{Binding SelectedSavedRequest}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SavedRequest}">
                                            <Grid Margin="0,2">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding Data.LoadSavedRequestCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <!-- Tinted backdrop: the opacity sits on its own layer so it doesn't fade the label too. -->
                                                    <Border CornerRadius="3" Opacity="0.2"
                                                            Background="{Binding Request.Method, Converter={StaticResource MethodToBrush}}"/>
                                                    <TextBlock Text="{Binding Request.Method}" FontSize="9" FontWeight="Bold" Margin="5,1"
                                                               Foreground="{Binding Request.Method, Converter={StaticResource MethodToBrush}}"/>
                                                </Grid>

                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding Request.Url}" FontSize="10"
                                                           FontFamily="{DynamicResource CodeFont}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>

                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Load"
                                                                  FontWeight="SemiBold"
                                                                  Command="{Binding Data.LoadSavedRequestCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Rename"
                                                                  Command="{Binding Data.RenameSavedRequestCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Duplicate"
                                                                  Command="{Binding Data.DuplicateSavedRequestCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Delete" Foreground="{DynamicResource AccentRed}"
                                                                  Command="{Binding Data.DeleteSavedRequestCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <!-- A single click on an item opens it (see the item template); no
                                         list-level double-click binding, which would open it a second time. -->
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Return"
                                                    Command="{Binding LoadSavedRequestCommand}"
                                                    CommandParameter="{Binding SelectedSavedRequest}"/>
                                    </ListBox.InputBindings>
                                </ListBox>

                                <TextBlock Grid.Row="1" Margin="20,24,20,0" VerticalAlignment="Top"
                                           TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="Nothing saved yet. Save current keeps the open request here, ready to reopen with one click.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SavedRequests.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Grid.Row="2" Padding="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Button Content="Save current" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding SaveCurrentRequestCommand}"
                                            HorizontalAlignment="Stretch" FontSize="11"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Padding="10,9">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="History" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding HistoryItems.Count}" FontSize="11" FontWeight="Normal"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         ItemsSource="{Binding HistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryItem}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:HistoryItem}">
                                            <Grid Margin="0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <!-- Tinted backdrop: the opacity sits on its own layer so it doesn't fade the label too. -->
                                                    <Border CornerRadius="3" Opacity="0.2"
                                                            Background="{Binding Method, Converter={StaticResource MethodToBrush}}"/>
                                                    <TextBlock Text="{Binding Method}" FontSize="9" FontWeight="Bold" Margin="5,1"
                                                               Foreground="{Binding Method, Converter={StaticResource MethodToBrush}}"/>
                                                </Grid>

                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                           Text="{Binding Url}" FontSize="12"
                                                           FontFamily="{DynamicResource CodeFont}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding SavedRequestName}" FontSize="10"
                                                           Foreground="{DynamicResource AccentBlue}"
                                                           Visibility="{Binding SavedRequestName, Converter={StaticResource NullToVisibility}}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                            Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border CornerRadius="3" Padding="4,1"
                                                            Background="{Binding StatusCode, Converter={StaticResource StatusCodeToBrush}}"
                                                            Opacity="0.85">
                                                        <TextBlock Text="{Binding StatusCode}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                               Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <Binding Path="Duration.TotalMilliseconds" StringFormat="{}{0:F0}ms"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding LoadHistoryItemCommand}"
                                                      CommandParameter="{Binding SelectedHistoryItem}"/>
                                    </ListBox.InputBindings>
                                </ListBox>

                                <TextBlock Grid.Row="0" Margin="20,24,20,0" VerticalAlignment="Top"
                                           TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                           Foreground="{DynamicResource TextSecondary}"
                                           Text="Every request you send is listed here. Double-click one to reopen exactly what was sent.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HistoryItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Grid.Row="1" Padding="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Button Content="Clear history" Style="{StaticResource DangerButton}"
                                            Command="{Binding ClearHistoryCommand}"
                                            HorizontalAlignment="Stretch" FontSize="11"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Padding="10,9">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Collections" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Collections.Roots.Count}" FontSize="11" FontWeight="Normal"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="8,6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Visibility="{Binding Collections.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Import" Style="{StaticResource OutlineButton}"
                                                Command="{Binding Collections.ImportCommand}"
                                                ToolTip="Import a Postman collection (v2.1) file"/>
                                        <Button Grid.Column="2" Content="+ New collection" Style="{StaticResource OutlineButton}"
                                                Command="{Binding Collections.NewCollectionCommand}"/>
                                    </Grid>
                                </Border>

                                <!-- Nothing here yet: say what a collection is for and offer the two ways to get one. -->
                                <StackPanel Grid.Row="1" Margin="20,24,20,0" VerticalAlignment="Top"
                                            Visibility="{Binding Collections.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="No collections yet" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="A collection keeps related requests together and gives them shared variables, so a login request can hand its token to the next one."/>
                                    <Border Margin="0,14,0,0" Padding="10,8" CornerRadius="4"
                                            Background="{DynamicResource BgInput}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock FontFamily="{DynamicResource CodeFont}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondary}">
                                            <Run Text="{}{{baseUrl}}" Foreground="{DynamicResource AccentOrange}"/><Run Text="/person/"/><Run Text="{}{{id}}" Foreground="{DynamicResource AccentOrange}"/>
                                        </TextBlock>
                                    </Border>
                                    <Button Content="Import a Postman collection" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding Collections.ImportCommand}"
                                            HorizontalAlignment="Stretch" FontSize="12" Margin="0,18,0,0"/>
                                    <Button Content="Start an empty collection" Style="{StaticResource OutlineButton}"
                                            Command="{Binding Collections.NewCollectionCommand}"
                                            HorizontalAlignment="Stretch" Padding="10,7" Margin="0,8,0,0"/>
                                </StackPanel>

                                <TreeView Grid.Row="1" ItemsSource="{Binding Collections.Roots}"
                                          Visibility="{Binding Collections.IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:CollectionNodeViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <!-- A click on the row opens a request or toggles a folder. -->
                                            <Grid Background="Transparent">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding Data.Collections.ActivateCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Requests: the method, in a fixed-width badge so names line up. -->
                                                <Grid Grid.Column="0" Width="44" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibility}}">
                                                    <Border CornerRadius="3" Opacity="0.2"
                                                            Background="{Binding Method, Converter={StaticResource MethodToBrush}}"/>
                                                    <TextBlock Text="{Binding Method}" FontSize="9" FontWeight="Bold" Margin="0,2"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{Binding Method, Converter={StaticResource MethodToBrush}}"/>
                                                </Grid>
                                                <!-- Folders: a folder glyph. Collections need neither: they are the top-level rows. -->
                                                <Path Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                                                      Data="M 0 1.5 C 0 0.7 0.7 0 1.5 0 L 4.5 0 L 6 1.5 L 11.5 1.5 C 12.3 1.5 13 2.2 13 3 L 13 8.5 C 13 9.3 12.3 10 11.5 10 L 1.5 10 C 0.7 10 0 9.3 0 8.5 Z"
                                                      Fill="{DynamicResource TextSecondary}" Opacity="0.75"
                                                      Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           ToolTip="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCollection}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="FontSize" Value="13"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- How many requests a collection or folder holds. -->
                                                <TextBlock Grid.Column="2" Text="{Binding RequestCount}" FontSize="11"
                                                           Margin="8,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}"/>

                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open" FontWeight="SemiBold"
                                                                  Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibility}}"
                                                                  Command="{Binding Data.Collections.ActivateCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Add current request here"
                                                                  Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}"
                                                                  Command="{Binding Data.Collections.AddCurrentRequestCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="New folder"
                                                                  Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}"
                                                                  Command="{Binding Data.Collections.NewFolderCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Variables and scripts..."
                                                                  Visibility="{Binding IsCollection, Converter={StaticResource BoolToVisibility}}"
                                                                  Command="{Binding Data.Collections.EditCollectionCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Export as Postman collection..."
                                                                  Visibility="{Binding IsCollection, Converter={StaticResource BoolToVisibility}}"
                                                                  Command="{Binding Data.Collections.ExportCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Rename"
                                                                  Command="{Binding Data.Collections.RenameNodeCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Duplicate"
                                                                  Command="{Binding Data.Collections.DuplicateNodeCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Delete" Foreground="{DynamicResource AccentRed}"
                                                                  Command="{Binding Data.Collections.DeleteNodeCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <Border Grid.Row="2" Padding="8,6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Visibility="{Binding Collections.StatusText, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Text="{Binding Collections.StatusText}" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Column="1" Width="3"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"/>

                <Grid Grid.Column="2">
                    <TabControl ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab}"
                                Background="Transparent">
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RequestWorkspaceViewModel}">
                                <StackPanel Orientation="Horizontal" MinWidth="120">
                                    <TextBlock Text="{Binding Title}"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="*" Margin="4,0,0,0"
                                               Foreground="{DynamicResource AccentYellow}"
                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="x"
                                            Style="{StaticResource GhostButton}"
                                            Padding="4,0"
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Close tab"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:RequestWorkspaceViewModel}">
                                <views:RequestWorkspaceView/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <Button Content="+"
                            Style="{StaticResource GhostButton}"
                            Width="28" Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,8,0"
                            Command="{Binding NewRequestCommand}"
                            ToolTip="New tab"/>
                </Grid>
            </Grid>

            <views:AiImportPanel Grid.RowSpan="2"
                                 Visibility="{Binding IsAiImportPanelOpen, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Border>
</Window>
