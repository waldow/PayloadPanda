<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>images\app.ico</ApplicationIcon>
    <!-- The test project lives in a subfolder; keep its sources out of the app's globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PayloadPanda.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window/title-bar icon, referenced from XAML as images/app.ico. -->
    <Resource Include="images\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact versions so every build (local and CI) resolves the same packages.
         DPAPI (System.Security.Cryptography.ProtectedData) needs no reference here: it ships
         with the Windows Desktop runtime that UseWPF already brings in. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
