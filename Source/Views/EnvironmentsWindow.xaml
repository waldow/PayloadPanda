<Window x:Class="PayloadPanda.Views.EnvironmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PayloadPanda.Views"
        Title="Environments"
        Width="820" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                      CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderRaised}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Environments" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="16,8,0,8"/>
                    <Button Grid.Column="1" Style="{StaticResource WindowChromeButton}"
                            Click="Cancel_Click" ToolTip="Close"
                            Width="36" Height="28">
                        <Path Data="M 0 0 L 8 8 M 0 8 L 8 0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="8" Height="8" Stretch="Uniform"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- The sets: globals first, then each environment -->
                <Border Grid.Column="0" Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="SetsList" Background="Transparent"
                                 SelectionChanged="SetsList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Note}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="1" Padding="8"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+ New" Style="{StaticResource OutlineButton}" Click="New_Click"
                                        ToolTip="Add an environment"/>
                                <Button Grid.Column="2" Content="Import" Style="{StaticResource OutlineButton}" Click="Import_Click"
                                        ToolTip="Import a Postman environment or globals file"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- The selected set -->
                <Grid Grid.Column="1" Margin="20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NameBox" FontSize="14" TextChanged="NameBox_TextChanged"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="DuplicateButton" Content="Duplicate" Style="{StaticResource GhostButton}" Click="Duplicate_Click"/>
                            <Button Content="Export" Style="{StaticResource GhostButton}" Click="Export_Click"
                                    ToolTip="Export as a Postman file (values in plain text)"/>
                            <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource GhostButton}"
                                    Foreground="{DynamicResource AccentRed}" Click="Delete_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HintText" Grid.Row="1" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,10"/>
                    <local:VariablesEditor x:Name="Variables" Grid.Row="2"/>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" MinWidth="80"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
