<UserControl x:Class="PayloadPanda.Views.RequestWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*" MinHeight="100"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                Padding="12,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="4" Margin="0,0,8,0" Padding="2"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource BgInput}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ModeTogglePill}" Content="HTTP"
                                     ToolTip="Standard request via HttpClient"
                                     IsChecked="{Binding SelectedRequestMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Http}"/>
                        <RadioButton Style="{StaticResource ModeTogglePill}" Content="RAW"
                                     ToolTip="Low-level TCP/TLS socket - inspect DNS, handshake, certs and raw bytes"
                                     IsChecked="{Binding SelectedRequestMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=RawSocket}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" CornerRadius="4" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Background="{DynamicResource BgInput}">
                    <ComboBox ItemsSource="{Binding AvailableMethods}"
                              SelectedItem="{Binding SelectedMethod}"
                              FontWeight="Bold" FontSize="13"
                              MinWidth="90" BorderThickness="0"
                              Foreground="{Binding SelectedMethod, Converter={StaticResource MethodToBrush}}"/>
                </Border>

                <TextBox Grid.Column="2"
                         Text="{Binding RequestUrl, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{DynamicResource CodeFont}"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Grid Grid.Column="3">
                    <Button Content="Send"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendCommand}"
                            MinWidth="80"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                    <Button Content="Cancel"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelCommand}"
                            MinWidth="80"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedRequestTabIndex}"
                    Background="Transparent">
            <TabItem Header="Params">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding QueryParams}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="x" Style="{StaticResource GhostButton}"
                                                FontSize="10" Padding="2"
                                                Command="{Binding DataContext.RemoveParamRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="+ Add Parameter"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding AddParamRowCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Headers">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding RequestHeaders}"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="x" Style="{StaticResource GhostButton}"
                                                FontSize="10" Padding="2"
                                                Command="{Binding DataContext.RemoveHeaderRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="+ Add Header"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding AddHeaderRowCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Auth">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel MaxWidth="500">
                        <Label Content="Authorization Type"/>
                        <ComboBox ItemsSource="{Binding AvailableAuthModes}"
                                  SelectedItem="{Binding SelectedAuthMode}"
                                  Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding SelectedAuthMode, Converter={StaticResource AuthModeToVisibility}, ConverterParameter=Bearer}">
                            <Label Content="Token"/>
                            <TextBox Text="{Binding AuthToken, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource CodeFont}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedAuthMode, Converter={StaticResource AuthModeToVisibility}, ConverterParameter=Basic}">
                            <Label Content="Username"/>
                            <TextBox Text="{Binding AuthUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>
                            <Label Content="Password"/>
                            <TextBox Text="{Binding AuthPassword, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding SelectedAuthMode, Converter={StaticResource AuthModeToVisibility}, ConverterParameter=ApiKey}">
                            <Label Content="Header Name"/>
                            <TextBox Text="{Binding ApiKeyHeader, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>
                            <Label Content="API Key Value"/>
                            <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource CodeFont}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Body">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Body type pills, and the Content-Type the body will go out with -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Padding="2" HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource BgInput}">
                            <StackPanel Orientation="Horizontal"
                                        KeyboardNavigation.TabNavigation="Once"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        AutomationProperties.Name="Body type">
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="None"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=None}"/>
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="Text"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Raw}"/>
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="JSON"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Json}"/>
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="XML"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Xml}"/>
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="URL-encoded"
                                             ToolTip="Key/value fields, sent as application/x-www-form-urlencoded (like a plain HTML form)"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=FormUrlEncoded}"/>
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="Form-data"
                                             ToolTip="Text fields and files, sent as multipart/form-data (like an HTML upload form)"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=FormData}"/>
                                <RadioButton Style="{StaticResource ModeTogglePill}" Content="Binary"
                                             ToolTip="One file sent as the whole request body"
                                             IsChecked="{Binding SelectedBodyMode, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Binary}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="12,0,2,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding EffectiveContentType, Converter={StaticResource NullToVisibility}}">
                            <Run Text="Sent as"/>
                            <Run Text="{Binding EffectiveContentType, Mode=OneWay}"
                                 FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>
                    </Grid>

                    <!-- A body with GET/HEAD is dropped by every transport: say so instead of failing silently -->
                    <Grid Grid.Row="1" Margin="0,0,0,8"
                          Visibility="{Binding IsBodyIgnoredForMethod, Converter={StaticResource BoolToVisibility}}">
                        <Border CornerRadius="4" Background="{DynamicResource AccentYellow}" Opacity="0.12"/>
                        <Border CornerRadius="4" BorderBrush="{DynamicResource AccentYellow}" BorderThickness="1" Opacity="0.45"/>
                        <TextBlock Text="{Binding BodyIgnoredText}" Foreground="{DynamicResource AccentYellow}"
                                   FontSize="12" Margin="10,6" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- None -->
                    <TextBlock Grid.Row="2" Margin="2,6,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="No body is sent. Pick a body type above to add one."
                               Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=None}"/>

                    <!-- Text / JSON / XML: kept named and always present so the code-behind sync works -->
                    <avalonedit:TextEditor
                        Grid.Row="2"
                        x:Name="RequestBodyEditor"
                        FontFamily="{DynamicResource CodeFont}"
                        FontSize="{Binding EditorFontSize}"
                        Background="{DynamicResource BgInput}"
                        Foreground="{DynamicResource TextPrimary}"
                        ShowLineNumbers="True"
                        WordWrap="{Binding EditorWordWrap}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        LineNumbersForeground="{DynamicResource TextMuted}"
                        Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter='Raw,Json,Xml'}"/>

                    <!-- URL-encoded and form-data: one list of fields; file parts and boundaries only in form-data -->
                    <Grid Grid.Row="2" x:Name="FormPartsPanel" Background="Transparent" AllowDrop="True"
                          PreviewDragEnter="FilesDragOver" PreviewDragOver="FilesDragOver"
                          PreviewDragLeave="FilesDragLeave" PreviewDrop="FilesDrop"
                          Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter='FormUrlEncoded,FormData'}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column headings, aligned with the row grid below -->
                        <Grid Grid.Row="0" Margin="0,0,10,4" TextElement.Foreground="{DynamicResource TextSecondary}"
                              TextElement.FontSize="11" TextElement.FontWeight="SemiBold">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*" MinWidth="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="On" Margin="6,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="Key" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Type" Width="84" Margin="4,0,0,0"
                                       Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}"/>
                            <TextBlock Grid.Column="3" Text="Value" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="Content type" Width="160" Margin="4,0,0,0"
                                       Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding FormFields}" IsTabStop="False" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid MinHeight="34">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*" MinWidth="90"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="6,0,0,0"
                                                              VerticalAlignment="Center" AutomationProperties.Name="Send this field"/>

                                                    <TextBox Grid.Column="1" Margin="2,3"
                                                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Field name"/>

                                                    <ComboBox Grid.Column="2" Width="84" Margin="2,3"
                                                              ItemsSource="{Binding DataContext.FormFieldKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Kind}"
                                                              AutomationProperties.Name="Field type"
                                                              Visibility="{Binding DataContext.SelectedBodyMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}"/>

                                                    <!-- Value: a text box, or a file chip for file fields -->
                                                    <Grid Grid.Column="3" Margin="2,3">
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.Name="Field value"
                                                                 Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                                                        <Grid Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                                            <!-- No file chosen yet -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                                <Button Content="Choose file…" Style="{StaticResource GhostButton}"
                                                                        Command="{Binding DataContext.ChooseFormFieldFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <TextBlock Text="or drop one onto this list" FontSize="11" Margin="6,0,0,0"
                                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                                            </StackPanel>

                                                            <!-- File chip -->
                                                            <Border CornerRadius="4" Padding="4,2" BorderThickness="1"
                                                                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgPanel}"
                                                                    ToolTip="{Binding FilePath}"
                                                                    Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <Border CornerRadius="3" Background="{DynamicResource AccentPurple}" Opacity="0.18"/>
                                                                        <TextBlock Text="{Binding ExtensionLabel}" FontSize="9" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource AccentPurple}" Margin="5,1"/>
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                                                                               FontFamily="{DynamicResource CodeFont}" FontSize="12"
                                                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding FileSizeText}" VerticalAlignment="Center"
                                                                               FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                                                                    <TextBlock Grid.Column="3" Text="missing" VerticalAlignment="Center"
                                                                               FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource AccentRed}"
                                                                               Visibility="{Binding FileMissing, Converter={StaticResource BoolToVisibility}}"/>
                                                                    <Button Grid.Column="4" Content="Change…" Style="{StaticResource GhostButton}"
                                                                            Padding="6,1" Margin="6,0,0,0" FontSize="11"
                                                                            Command="{Binding DataContext.ChooseFormFieldFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Per-part Content-Type; the placeholder shows what's sent when it's blank -->
                                                    <Grid Grid.Column="4" Width="160" Margin="2,3"
                                                          Visibility="{Binding DataContext.SelectedBodyMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}">
                                                        <TextBox Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontFamily="{DynamicResource CodeFont}" FontSize="11"
                                                                 AutomationProperties.Name="Part content type"/>
                                                        <TextBlock Text="{Binding ContentTypePlaceholder}" IsHitTestVisible="False"
                                                                   FontFamily="{DynamicResource CodeFont}" FontSize="11"
                                                                   Foreground="{DynamicResource TextMuted}" Margin="9,0,4,0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding ContentType, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                                                    </Grid>

                                                    <Button Grid.Column="5" Content="✕" Style="{StaticResource GhostButton}"
                                                            FontSize="10" Padding="4,2" ToolTip="Remove this field"
                                                            AutomationProperties.Name="Remove field"
                                                            Command="{Binding DataContext.RemoveFormFieldRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>

                                                <!-- The multipart boundary between parts -->
                                                <Line X1="0" X2="1" Stretch="Fill" StrokeThickness="1" StrokeDashArray="4 3"
                                                      Stroke="{DynamicResource BorderBrush}" SnapsToDevicePixels="True" Margin="0,1"
                                                      Visibility="{Binding DataContext.SelectedBodyMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- URL-encoded: add a field -->
                                <Button Content="+ Add field" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                        Margin="0,6,0,0" Command="{Binding AddFormFieldRowCommand}"
                                        Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormUrlEncoded}"/>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer: the form-data summary, or the exact URL-encoded body -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <!-- Form-data: the drop zone, always in view below the list -->
                            <Grid MinHeight="46" Margin="0,0,0,8"
                                  Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}">
                                <Rectangle x:Name="FormDropOutline" RadiusX="6" RadiusY="6" StrokeThickness="1.5"
                                           StrokeDashArray="4 3" Stroke="{DynamicResource BorderBrush}" Fill="Transparent"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,6">
                                    <TextBlock Text="Drop files here to add them" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                                    <Button Content="Choose files…" Style="{StaticResource GhostButton}"
                                            Command="{Binding ChooseFormFilesCommand}" Margin="0,0,4,0"/>
                                    <Button Content="Add text field" Style="{StaticResource GhostButton}"
                                            Command="{Binding AddFormFieldRowCommand}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding FormDataSummary}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormData}"/>

                            <StackPanel Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=FormUrlEncoded}">
                                <TextBlock Text="Sent as" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding UrlEncodedPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="96" VerticalScrollBarVisibility="Auto"
                                         FontFamily="{DynamicResource CodeFont}" FontSize="12"
                                         AutomationProperties.Name="Encoded body"
                                         Visibility="{Binding UrlEncodedPreview, Converter={StaticResource NullToVisibility}}"/>
                                <TextBlock Text="Nothing to send yet. Add a field with a name." FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           Visibility="{Binding UrlEncodedPreview, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                                <TextBlock Text="{Binding IgnoredFileFieldsText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentYellow}"
                                           Visibility="{Binding IgnoredFileFieldsText, Converter={StaticResource NullToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Binary: one file as the whole body -->
                    <Grid Grid.Row="2" x:Name="BinaryPanel" Background="Transparent" AllowDrop="True"
                          PreviewDragEnter="FilesDragOver" PreviewDragOver="FilesDragOver"
                          PreviewDragLeave="FilesDragLeave" PreviewDrop="FilesDrop"
                          Visibility="{Binding SelectedBodyMode, Converter={StaticResource EnumToVisibility}, ConverterParameter=Binary}">
                        <!-- Empty: a drop zone -->
                        <Grid MinHeight="150" VerticalAlignment="Top"
                              Visibility="{Binding BinaryHasFile, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.5" StrokeDashArray="4 3"
                                       Stroke="{DynamicResource BorderBrush}" Fill="Transparent"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <TextBlock Text="Drop a file here, or choose one." FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="It's sent as the whole request body." FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,12"/>
                                <Button Content="Choose file…" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"
                                        Command="{Binding ChooseBinaryFileCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- File card -->
                        <Border VerticalAlignment="Top" CornerRadius="6" Padding="16" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource BgSurface}"
                                Visibility="{Binding BinaryHasFile, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,14,0">
                                    <Border CornerRadius="6" Background="{DynamicResource AccentPurple}" Opacity="0.18"/>
                                    <TextBlock Text="{Binding BinaryExtensionLabel}" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentPurple}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BinaryFileName}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding BinaryFilePath}" FontFamily="{DynamicResource CodeFont}" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding BinaryFilePath}" Margin="0,2,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BinaryFileSizeText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0"/>
                                        <TextBlock Text="This file doesn't exist any more." FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentRed}" Margin="0,0,14,0"
                                                   Visibility="{Binding BinaryFileMissing, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                            <Run Text="Content-Type"/>
                                            <Run Text="{Binding BinaryContentType, Mode=OneWay}" FontFamily="{DynamicResource CodeFont}"
                                                 Foreground="{DynamicResource TextPrimary}"/>
                                            <Run Text="{Binding BinaryContentTypeSource, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="Change…" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                            Command="{Binding ChooseBinaryFileCommand}"/>
                                    <Button Content="Remove" Style="{StaticResource GhostButton}"
                                            Command="{Binding ClearBinaryFileCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Shown while files are dragged over the panel -->
                        <Rectangle x:Name="BinaryDropOverlay" RadiusX="6" RadiusY="6" StrokeThickness="2" StrokeDashArray="4 3"
                                   Stroke="{DynamicResource AccentBlue}" Fill="#1A58A6FF" IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel MaxWidth="560">
                        <Label Content="Timeout (seconds)"/>
                        <TextBox Text="{Binding RequestTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,12"/>

                        <CheckBox Content="Follow redirects"
                                  IsChecked="{Binding RequestFollowRedirects}"
                                  Margin="0,0,0,8"/>

                        <!-- CORS troubleshooting -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>
                        <TextBlock Text="CORS Troubleshooting"
                                   FontWeight="Bold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Add an Origin to every request and run an OPTIONS preflight to see why a browser would block it."
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="Enable CORS testing"
                                  IsChecked="{Binding CorsEnabled}"
                                  Margin="0,0,0,8"/>

                        <StackPanel Visibility="{Binding CorsEnabled, Converter={StaticResource BoolToVisibility}}">
                            <Label Content="Origin"/>
                            <TextBox Text="{Binding CorsOrigin, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource CodeFont}"
                                     Margin="0,0,0,8"
                                     ToolTip="The site making the request, e.g. https://app.example.com"/>

                            <Label Content="Access-Control-Request-Method (preflight)"/>
                            <TextBox Text="{Binding CorsRequestMethod, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource CodeFont}"
                                     Margin="0,0,0,8"
                                     ToolTip="Method the real request will use. Defaults to the selected method when blank."/>

                            <Label Content="Access-Control-Request-Headers (preflight)"/>
                            <TextBox Text="{Binding CorsRequestHeaders, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{DynamicResource CodeFont}"
                                     Margin="0,0,0,8"
                                     ToolTip="Comma-separated custom headers. Leave blank to derive from the current request."/>

                            <CheckBox Content="Include credentials (cookies / Authorization)"
                                      IsChecked="{Binding CorsIncludeCredentials}"
                                      Margin="0,0,0,10"/>

                            <Button Content="Send Preflight (OPTIONS)"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding SendPreflightCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,12"/>

                            <!-- Verdict -->
                            <Border Visibility="{Binding HasCorsVerdict, Converter={StaticResource BoolToVisibility}}"
                                    Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding CorsVerdict.Summary}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding CorsVerdict.Checks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="8" Height="8" CornerRadius="4"
                                                            VerticalAlignment="Top" Margin="0,4,8,0"
                                                            Background="{Binding Status, Converter={StaticResource CorsStatusToBrush}}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource CorsStatusToBrush}}"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" Height="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"/>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                    Padding="12,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                                Visibility="{Binding CurrentResponse, Converter={StaticResource NullToVisibility}}"
                                Background="{Binding CurrentResponse.StatusCode, Converter={StaticResource StatusCodeToBrush}}">
                            <TextBlock FontWeight="Bold" FontSize="12" Foreground="White">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="CurrentResponse.StatusCode"/>
                                        <Binding Path="CurrentResponse.ReasonPhrase"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>

                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding CurrentResponse, Converter={StaticResource NullToVisibility}}">
                            <TextBlock.Text>
                                <Binding Path="CurrentResponse.Duration.TotalMilliseconds" StringFormat="{}{0:F0} ms"/>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding CurrentResponse, Converter={StaticResource NullToVisibility}}"
                                   Text="{Binding CurrentResponse.ResponseSize, Converter={StaticResource FileSizeConverter}}"/>

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding CurrentResponse, Converter={StaticResource NullToVisibility}}">
                        <Button Content="Download" Style="{StaticResource GhostButton}"
                                Command="{Binding DownloadResponseCommand}" Margin="0,0,4,0"/>
                        <Button Content="Copy Body" Style="{StaticResource GhostButton}"
                                Command="{Binding CopyResponseBodyCommand}" Margin="0,0,4,0"/>
                        <Button Content="Copy Curl" Style="{StaticResource GhostButton}"
                                Command="{Binding CopyAsCurlCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding SelectedResponseTabIndex}"
                        Background="Transparent">
                <TabItem Header="Pretty">
                    <avalonedit:TextEditor
                        x:Name="ResponsePrettyEditor"
                        FontFamily="{DynamicResource CodeFont}"
                        FontSize="{Binding EditorFontSize}"
                        Background="{DynamicResource BgInput}"
                        Foreground="{DynamicResource TextPrimary}"
                        ShowLineNumbers="True"
                        IsReadOnly="True"
                        WordWrap="{Binding EditorWordWrap}"
                        BorderThickness="0"
                        LineNumbersForeground="{DynamicResource TextMuted}"/>
                </TabItem>

                <TabItem Header="Raw">
                    <!-- AvalonEdit rather than TextBox: it virtualizes lines, so a large body
                         doesn't freeze the UI. Text is set from code-behind. -->
                    <avalonedit:TextEditor
                        x:Name="ResponseRawEditor"
                        FontFamily="{DynamicResource CodeFont}"
                        FontSize="{Binding EditorFontSize}"
                        Background="{DynamicResource BgInput}"
                        Foreground="{DynamicResource TextPrimary}"
                        ShowLineNumbers="True"
                        IsReadOnly="True"
                        WordWrap="{Binding EditorWordWrap}"
                        BorderThickness="0"
                        LineNumbersForeground="{DynamicResource TextMuted}"/>
                </TabItem>

                <TabItem Header="Headers">
                    <DataGrid ItemsSource="{Binding ResponseHeaders}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="4">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource CodeFont}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Connection"
                         Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12"
                                  DataContext="{Binding ConnectionDiagnostics}">
                        <StackPanel>
                            <Border Margin="0,0,0,16" Padding="12,10" CornerRadius="6"
                                    Background="#2D1418" BorderBrush="#5C2329" BorderThickness="1"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="#F85149" FontWeight="Bold" FontSize="13">
                                        <Run Text="x "/><Run Text="{Binding FailedPhase, Mode=OneWay}"/><Run Text=" phase failed"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ENDPOINT" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding Scheme, Mode=OneWay}"/><Run Text="://"/><Run Text="{Binding Host, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Resolved IPs" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ResolvedIpSummary}" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Connected to" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RemoteEndpoint}" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Local endpoint" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LocalEndpoint}" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2"/>
                            </Grid>

                            <TextBlock Text="TIMING" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding DataContext.TimingPhases, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource CodeFont}" FontSize="11"
                                                       Foreground="{Binding Label, Converter={StaticResource DiagnosticBrush}}"/>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource WaterfallBar}"
                                                         Value="{Binding Milliseconds, Mode=OneWay}"
                                                         Maximum="{Binding ScaleMax, Mode=OneWay}"
                                                         Foreground="{Binding Label, Converter={StaticResource DiagnosticBrush}}"
                                                         VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MsDisplay}" VerticalAlignment="Center"
                                                       TextAlignment="Right" FontFamily="{DynamicResource CodeFont}"
                                                       FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,2,0,18" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                <Run Text="Total: "/><Run FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" Text="{Binding Timings.TotalMs, Mode=OneWay, StringFormat={}{0:F0} ms}"/>
                            </TextBlock>

                            <StackPanel Visibility="{Binding IsSecure, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="TLS" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Protocol" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TlsProtocol}" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource AccentGreen}" FontSize="12" FontWeight="SemiBold" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cipher suite" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CipherSuite}" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Validation" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SslPolicyErrors}" FontFamily="{DynamicResource CodeFont}" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,2"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding CertificatesPresent, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="CERTIFICATE CHAIN" Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Certificates}" Margin="0,0,0,18">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Border Background="{DynamicResource BgInput}" CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                        </Border>
                                                        <Border CornerRadius="3" Padding="6,2"
                                                                Background="{Binding Status, Converter={StaticResource DiagnosticBrush}}">
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subject}" FontFamily="{DynamicResource CodeFont}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                                                        <Run Text="Issuer: "/><Run Text="{Binding Issuer, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                                        <Run Text="Valid: "/><Run Text="{Binding NotBefore, Mode=OneWay, StringFormat=yyyy-MM-dd}"/><Run Text=" to "/><Run Text="{Binding NotAfter, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                                                        <Run Text="SAN: "/><Run Text="{Binding SansSummary, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="{DynamicResource CodeFont}" TextWrapping="Wrap">
                                                        <Run Text="{Binding SignatureAlgorithm, Mode=OneWay}"/><Run Text=" - SN "/><Run Text="{Binding SerialNumber, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="RAW REQUEST" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding RawRequest, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="{DynamicResource CodeFont}" FontSize="12"
                                     Background="{DynamicResource BgInput}" BorderThickness="1"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                     Padding="10" Margin="0,0,0,18"/>

                            <TextBlock Text="RAW RESPONSE HEAD" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding RawResponseHead, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="{DynamicResource CodeFont}" FontSize="12"
                                     Background="{DynamicResource BgInput}" BorderThickness="1"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                                     Padding="10"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.RowSpan="4"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Sending request..."
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="14" HorizontalAlignment="Center"/>
                <Button Content="Cancel" Style="{StaticResource DangerButton}"
                        Command="{Binding CancelCommand}"
                        Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
