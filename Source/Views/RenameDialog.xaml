<Window x:Class="PayloadPanda.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Foreground="{DynamicResource TextPrimary}">

    <!-- A raised card: the transparent margin gives the shadow room, so the dialog reads as
         sitting above the window instead of blending into it. Sized by its content, so the
         text box can never be clipped at larger font or DPI settings. -->
    <Border Margin="24" CornerRadius="8"
            Background="{DynamicResource BgSurface}"
            BorderBrush="{DynamicResource BorderRaised}" BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="20,18,20,16">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBox x:Name="NameBox" FontSize="13" Margin="0,14,0,0"
                     TextChanged="NameBox_TextChanged"
                     KeyDown="NameBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}"
                        Click="Cancel_Click" Margin="0,0,8,0" Padding="12,7"/>
                <Button x:Name="ActionButton" Content="Rename" Style="{StaticResource PrimaryButton}"
                        Click="OK_Click" MinWidth="84" Padding="16,7"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
