<Window x:Class="PayloadPanda.Views.CollectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collection"
        Width="680" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                      CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderAccent}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Collection: variables and scripts" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="16,8,0,8"/>
                    <Button Grid.Column="1" Style="{StaticResource WindowChromeButton}"
                            Click="Cancel_Click" ToolTip="Close"
                            Width="36" Height="28">
                        <Path Data="M 0 0 L 8 8 M 0 8 L 8 0"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="8" Height="8" Stretch="Uniform"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel>
                    <Label Content="Name"/>
                    <TextBox x:Name="NameBox" Margin="0,0,0,8"/>

                    <Label Content="Description"/>
                    <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="54" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                    <TextBlock Text="VARIABLES" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"
                               Text="Write {{name}} in a URL, header, parameter, body or auth field to use a variable. Secret values are encrypted on this PC; exported files hold them in plain text."/>
                    <DataGrid x:Name="VariablesGrid" Height="210"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            <DataGridTextColumn Header="Variable" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource BgInput}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Secret" Binding="{Binding IsSecret, UpdateSourceTrigger=PropertyChanged}" Width="56"/>
                            <DataGridTemplateColumn Header="" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="x" Style="{StaticResource GhostButton}"
                                                FontSize="10" Padding="2"
                                                Click="RemoveVariable_Click" Tag="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="+ Add Variable" Style="{StaticResource GhostButton}"
                            Click="AddVariable_Click" HorizontalAlignment="Left" Margin="0,4,0,16"/>

                    <TextBlock Text="COLLECTION SCRIPTS" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                    <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"
                               Text="Run for every request in the collection, before the request's own scripts."/>
                    <Label Content="Pre-request"/>
                    <TextBox x:Name="PreRequestBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             FontFamily="{DynamicResource CodeFont}" FontSize="12"
                             Height="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Margin="0,0,0,8"/>
                    <Label Content="Tests"/>
                    <TextBox x:Name="TestBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             FontFamily="{DynamicResource CodeFont}" FontSize="12"
                             Height="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}"
                            Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" MinWidth="80"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
